# Copy to .env.local and fill in real values. Do NOT commit .env.local.
# PostgreSQL connection string.
# Note: URL-encode special characters in the password (e.g. "%" -> "%25").
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dwm"

# Redis connection string (used for refresh-token storage).
REDIS_URL="redis://localhost:6379"

# JWT signing secret (any long random string). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-long-random-secret"
